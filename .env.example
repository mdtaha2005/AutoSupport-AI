# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/customer_tickets_db?schema=public"

# NLP Microservice (Phase 2)
NLP_SERVICE_URL=http://localhost:8000

# Redis Configuration (Phase 3: BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Routing & Scoring Weights (Phase 3)
ROUTING_SKILL_WEIGHT=0.40
ROUTING_WORKLOAD_WEIGHT=0.35
ROUTING_AVAILABILITY_WEIGHT=0.25

# Search & Hybrid Retrieval (Phase 4)
HYBRID_SEARCH_ALPHA=0.50
PGVECTOR_DIMENSION=384
RRF_K=60

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_phase1_min_32_chars_long
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Admin Seed Defaults
DEFAULT_ADMIN_EMAIL=admin@ticketrouting.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME="System Administrator"
